# ============================================
# Shopify Marketing AI - Backend Environment
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!
#
# TIP: This repo is an npm workspace. If NODE_ENV=production is set,
# npm install silently skips devDependencies (tsc/jest/next missing).
# Always use: npm install --include=dev

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5001
API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Format: postgresql://user:password@host:port/database
# For Railway: Use the DATABASE_URL provided by Railway
# For local: postgresql://postgres:password@localhost:5432/shopify_marketing_ai
DATABASE_URL=postgresql://user:password@localhost:5432/shopify_marketing_ai

# ============================================
# REDIS (For Job Queue)
# ============================================
# For Railway: Use the REDIS_URL provided by Railway
# For local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================
# API AUTHENTICATION
# ============================================
# Generate a secure random string for API key
# You can use: openssl rand -hex 32
# NOTE: This is a single shared key (see gap analysis C2). Add real auth
# (JWT + users + roles) before exposing on a public domain.
API_KEY=your-secure-api-key-change-this-to-random-string

# ============================================
# SHOPIFY INTEGRATION
# ============================================
# Dev Dashboard app (dev.shopify.com): CLIENT ID = SHOPIFY_API_KEY,
# CLIENT SECRET = SHOPIFY_API_SECRET.
# SHOPIFY_ACCESS_TOKEN is fetched via client-credentials grant
# (see scripts/shopify-auth/) and expires every 24h.
SHOPIFY_STORE_URL=rqukgw-tx.myshopify.com
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token

# ============================================
# META (Facebook/Instagram Ads)
# ============================================
# Get these from: https://developers.facebook.com/
# Note: ad creative creation requires the Meta app to be in Live mode (App Review).
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token
META_AD_ACCOUNT_ID=act_your_ad_account_id
META_PAGE_ID=your_facebook_page_id
# Pixel used for conversion (OFFSITE_CONVERSIONS) ad sets
META_PIXEL_ID=your_pixel_id
META_CUSTOM_EVENT=PURCHASE
# Minimum daily budget for ad sets (INR accounts require > ~96.33)
META_MIN_DAILY_BUDGET=100
# Fallback landing link for ad creatives
META_DEFAULT_LINK=https://your-store.myshopify.com

# ============================================
# GOOGLE ADS (Optional - stub, not implemented)
# ============================================
GOOGLE_ADS_CLIENT_ID=your_google_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID=your_customer_id

# ============================================
# AI PROVIDER (Primary)
# ============================================
# Which provider to use: opencode | gemini
# NOTE: default is "opencode" if unset — set this explicitly!
AI_PROVIDER=opencode

# OpenCode Go — OpenAI-compatible gateway ($10/mo)
# Get your key: https://opencode.ai/auth
OPENCODE_API_KEY=your_opencode_api_key
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# Cheap fast models: mimo-v2.6-flash, deepseek-v4-flash, glm-5.3-flash, longcat-2.0
OPENCODE_MODEL=mimo-v2.6-flash

# ============================================
# AI PROVIDER (Fallback)
# ============================================
# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# ============================================
# EMAIL PLATFORM (Optional - NOT IMPLEMENTED)
# ============================================
KLAVIYO_API_KEY=your_klaviyo_api_key
KLAVIYO_LIST_ID=your_klaviyo_list_id

# ============================================
# NOTIFICATIONS (optional)
# ============================================
# Set NOTIFY_WEBHOOK_URL to a Slack/Discord/Telegram bridge URL to receive
# alerts (pending approvals, rule triggered, budget changed).
NOTIFY_ENABLED=true
NOTIFY_WEBHOOK_URL=

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_AI_CONTENT_GENERATION=true
# Only execute rule actions directly when a rule opts out of approval.
ENABLE_AUTO_APPROVAL=false
AUTO_APPROVAL_THRESHOLD=20

# ============================================
# LOGGING
# ============================================
# Options: error, warn, info, debug
LOG_LEVEL=info
